[git]
  autoUpdate = true

# All data values are managed by `dots-setup` (~/.local/bin/dots-setup).
# This template provides safe defaults for the initial `chezmoi init` run
# before the wizard has been executed. Run `dots-setup` to configure.

[data]
  profile        = "custom"
  editor         = "fresh"
  touch_id_sudo  = false

  alt_tools      = false
  bitwarden      = false
  bw_email       = ""
  docker         = false
  kubernetes     = false
  macos_utils    = false
  macos_cosmetic = false
  macos_media    = false
  dev_apps       = false
  touchbar       = false
  gaming         = false
  productivity   = false
  peripherals    = false

  machine_excludes = []

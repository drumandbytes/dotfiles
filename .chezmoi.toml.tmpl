# All data values are managed by `dots-setup` (~/.local/bin/dots-setup).
# This template provides safe defaults for the initial `chezmoi init` run
# before the wizard has been executed. Run `dots-setup` to configure.

[data]
  profile        = "custom"
  editor         = "fresh"
  touch_id_sudo  = false

  alt_tools      = false
  docker         = false
  kubernetes     = false
  macos_utils    = false
  macos_cosmetic = false
  macos_media    = false
  dev_apps       = false
  touchbar       = false
  gaming         = false
  productivity   = false
  peripherals    = false
  onepassword    = false

  machine_excludes = []

  # Hammerspoon darkmode.lua — auto light/dark by local sunrise/sunset.
  # Offsets are minutes relative to the event (negative = before, positive = after).
  darkmode_city               = "Tallinn, Estonia"
  darkmode_latitude           = 59.4370
  darkmode_longitude          = 24.7536
  darkmode_sunset_offset_min  = -30
  darkmode_sunrise_offset_min = 0

# Homebrew & Editor
export HOMEBREW_NO_ENV_HINTS=true
# Skip macOS Gatekeeper quarantine on cask installs — no "unverified developer"
# prompt and no "downloaded from the internet" dialog on first launch.
export HOMEBREW_CASK_OPTS="--no-quarantine"
export EDITOR="{{ .editor }}"
export ZSH_AUTOSUGGEST_MANUAL_REBIND=1
export CARAPACE_LENIENT=1

# fzf configuration
{{ if and .alt_tools (not (has "fd" .machine_excludes)) -}}
export FZF_DEFAULT_COMMAND='fd --type f --strip-cwd-prefix --hidden --follow --exclude .git --exclude node_modules --exclude .DS_Store'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
{{ end -}}
if [[ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" == "Dark" ]]; then
    export COLORFGBG="15;0"
    export BAT_THEME="Catppuccin Macchiato"
    _fzf_colors="--color=bg+:#363a4f,bg:#24273a,spinner:#f4dbd6,hl:#ed8796
      --color=fg:#cad3f5,header:#ed8796,info:#c6a0f6,pointer:#f4dbd6
      --color=marker:#b7bdf8,fg+:#cad3f5,prompt:#c6a0f6,hl+:#ed8796
      --color=selected-bg:#494d64,border:#363a4f,label:#cad3f5"
else
    export COLORFGBG="0;15"
    export BAT_THEME="Catppuccin Latte"
    _fzf_colors="--color=bg+:#ccd0da,bg:#eff1f5,spinner:#dc8a78,hl:#d20f39
      --color=fg:#4c4f69,header:#d20f39,info:#8839ef,pointer:#dc8a78
      --color=marker:#7287fd,fg+:#4c4f69,prompt:#8839ef,hl+:#d20f39
      --color=selected-bg:#bcc0cc,border:#ccd0da,label:#4c4f69"
fi
export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border
{{ if and .alt_tools (not (has "bat" .machine_excludes)) -}}
  --preview 'bat --color=always --style=numbers --line-range :500 {}'
{{ end -}}
  ${_fzf_colors}"
unset _fzf_colors
# Note: CTRL+R is handled by atuin (not fzf)

# Catppuccin syntax highlighting (must be sourced before zsh-syntax-highlighting loads)
if [[ "$COLORFGBG" = "15;0" ]]; then
    source ~/.zsh/catppuccin_macchiato-zsh-syntax-highlighting.zsh
else
    source ~/.zsh/catppuccin_latte-zsh-syntax-highlighting.zsh
fi

# Paths
# Note: java, node, ruby, uv runtimes are managed by mise — no manual PATH entries needed.
export PATH="$HOME/.local/bin:{{ if .kubernetes }}${KREW_ROOT:-$HOME/.krew}/bin:{{ end }}$PATH"
[[ -d "$HOME/.opencode/bin" ]] && export PATH="$HOME/.opencode/bin:$PATH"

# Fpath (Completions)
fpath=(~/.zsh/completions {{ if .docker }}$HOME/.docker/completions {{ end }}/opt/homebrew/share/zsh/site-functions $fpath)

# App specific
export LG_CONFIG_FILE="$HOME/.config/lazygit/theme.yml"
export LESSHSTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/lesshst"
{{ if .onepassword }}
# 1Password — SSH agent + `op` CLI shell plugins
_op_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
[[ -S "$_op_sock" ]] && export SSH_AUTH_SOCK="$_op_sock"
unset _op_sock
[[ -f "${XDG_CONFIG_HOME:-$HOME/.config}/op/plugins.sh" ]] && source "${XDG_CONFIG_HOME:-$HOME/.config}/op/plugins.sh"

# Secret *references*, not secrets — resolved per-command by `op run --`
# (see the `claude` wrapper in aliases.zsh). Never written to disk resolved.
export ANTHROPIC_API_KEY="op://Private/Claude API Key/credential"
{{ end }}
# Machine-local shell overrides — untracked, not in the repo (PATH tweaks,
# extra `op://` refs, per-host settings). Keep resolved secrets out of it.
[[ -f ~/.zsh/local.zsh ]] && source ~/.zsh/local.zsh

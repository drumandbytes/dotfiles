{{ if .alt_tools -}}
# --- Alt-tools (modern CLI replacements) ---
{{ if not (has "eza" .machine_excludes) -}}
alias ls='eza --icons --group-directories-first'
alias l='eza -lh --git --icons --group-directories-first'
alias la='eza -la --git --icons --group-directories-first'
alias tree='eza --tree --icons'
{{ end -}}
{{ if not (has "duf" .machine_excludes) -}}
alias df='duf'
{{ end -}}
{{ if not (has "dust" .machine_excludes) -}}
alias du='dust'
{{ end -}}
{{ if not (has "fd" .machine_excludes) -}}
alias find='fd'
{{ end -}}
{{ if not (has "ripgrep" .machine_excludes) -}}
alias grep='rg'
{{ end -}}
{{ if not (has "doggo" .machine_excludes) -}}
alias dig='doggo'
{{ end -}}
{{ if not (has "tldr" .machine_excludes) -}}
alias man='tldr'
{{ end -}}
{{- end }}

{{ if .kubernetes -}}
# --- Kubernetes ---
alias kubectl='kubecolor'        # colorised kubectl; compdef set in .zshrc
alias k='kubectl'
alias kx='kubectx'
alias kn='kubens'
alias kgp='k get pods'
alias kgd='k get deployments'
alias kgs='k get service'
alias kga='k get all'
alias kl='k logs -f'             # single pod
alias ksl='stern'                # multi-pod / pattern-based log tailing
alias kex='k exec -it'
{{- end }}

# --- Git & Workflow ---
alias lg='lazygit'
alias copylast="fc -ln -1 | sed 's/^[ \t]*//' | pbcopy"

# --- Config Management ---
alias zshconfig="chezmoi edit ~/.zshrc"
alias envconfig="chezmoi edit ~/.zsh/env.zsh"
alias aliasconfig="chezmoi edit ~/.zsh/aliases.zsh"
alias funcconfig="chezmoi edit ~/.zsh/functions.zsh"
alias sheldonconfig="chezmoi edit ~/.config/sheldon/plugins.toml"
alias reload="exec zsh"

# --- Maintenance & Updates ---
{{ if and .alt_tools (not (has "tldr" .machine_excludes)) -}}
alias brew-up="brew update && brew upgrade --greedy && brew cleanup --prune=all && tldr --update"
{{- else -}}
alias brew-up="brew update && brew upgrade --greedy && brew cleanup --prune=all"
{{- end }}
alias sheldon-up="sheldon lock --update && sheldon source > ~/.zsh/sheldon.zsh && echo 'Sheldon updated.'"
{{ if and .alt_tools (not (has "navi" .machine_excludes)) -}}
alias navi-up="for d in ~/.local/share/navi/cheats/*/; do echo \"Updating \$(basename \$d)...\"; git -C \"\$d\" fetch --depth=1 --quiet origin HEAD && git -C \"\$d\" reset --quiet --hard FETCH_HEAD || echo \"⚠️  Failed: \$d\"; done && touch ~/.local/share/navi/cheats/.last_updated && echo 'Navi repos updated.'"
{{ end -}}
alias atuin-clean="atuin search --cmd-only --limit 10000 | fzf --multi | while read -r cmd; do atuin search --delete \"\$cmd\"; done"
alias dots-setup="~/.local/bin/dots-setup"
alias dots-diff="chezmoi diff"
alias dots-add="chezmoi add"
alias dots-edit="chezmoi edit"
alias dots-apply="chezmoi apply"
alias dots-status="chezmoi status"
alias dots-push="git -C \$(chezmoi source-path) push"
alias dots-log="git -C \$(chezmoi source-path) log --oneline -20"

# --- Global Aliases ---
alias -g L='| less'
alias -g G='| grep'
alias -g H='| head'
alias -g T='| tail'
{{ if and .alt_tools (not (has "jid" .machine_excludes)) -}}
alias -g CJ='| jid'
{{- end }}

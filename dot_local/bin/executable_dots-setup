#!/bin/zsh
# dots-setup — interactive machine profile wizard
# Writes ~/.config/chezmoi/chezmoi.toml then runs chezmoi apply.
# Run any time to reconfigure this machine.

set -euo pipefail

CHEZMOI_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/chezmoi.toml"

bold=$'\e[1m'; reset=$'\e[0m'; cyan=$'\e[36m'; green=$'\e[32m'; dim=$'\e[2m'

if ! command -v fzf &>/dev/null; then
  echo "fzf is required (brew install fzf). Run 'chezmoi apply' first to install base packages." >&2
  exit 1
fi

# ── Package registry ─────────────────────────────────────────────────────────
# CAT_ORDER defines display order. CAT_PKGS lists every individually-selectable
# package within each category — names match the identifiers used in the
# Brewfile's has .machine_excludes checks.

CAT_ORDER=(alt_tools onepassword docker kubernetes macos_utils macos_cosmetic macos_media dev_apps touchbar gaming productivity peripherals)

typeset -A CAT_DESC=(
  [alt_tools]="Modern CLI replacements"
  [onepassword]="1Password (app + op CLI)"
  [docker]="Docker via Colima (colima + docker + buildx + compose)"
  [kubernetes]="k8s tools (kubectl, k9s, helm, kustomize, aws/gcloud…)"
  [macos_utils]="macOS utilities (Raycast, Hammerspoon, AltTab…)"
  [macos_cosmetic]="Visual extras (AirBattery, BoringNotch, Cork)"
  [macos_media]="Media & communication"
  [dev_apps]="Dev tools (VSCodium, DBeaver, gh, glab…)"
  [touchbar]="BetterTouchTool (TouchBar Macs only)"
  [gaming]="Steam, Discord"
  [productivity]="Notion, Obsidian, Grammarly, Calibre, Flux Markdown"
  [peripherals]="8BitDo, QMK Toolbox, BalenaEtcher, F3"
)

typeset -A CAT_PKGS=(
  [alt_tools]="bat doggo duf dust eza fd gping gron jid navi ripgrep tldr xh"
  [onepassword]="1password 1password-cli"
  [docker]="docker"
  [kubernetes]="helm kubectx k9s kubeconform mintoolkit stern gcloud-cli awscli kustomize"
  [macos_utils]="alt-tab displaylink hammerspoon hot logi-options-plus raycast sniffnet keyboardcleantool netspot nordvpn transmission utm duckdb hyperfine darrylmorley/whatcable/whatcable"
  [macos_cosmetic]="airbattery boring-notch cork"
  [macos_media]="brave-browser slack spotify telegram iina"
  [dev_apps]="ffmpeg gh git-filter-repo glab libpq php composer claude claude-usage-tracker opencode-desktop jetbrains-toolbox dbeaver-community gimp rtk vscodium webp cyberduck cloudflared hcloud uv opentofu caddy siderolabs/tap/talosctl"
  [touchbar]="bettertouchtool"
  [gaming]="discord steam"
  [productivity]="calibre flux-markdown grammarly-desktop notion obsidian"
  [peripherals]="8bitdo-ultimate-software balenaetcher f3 qmk-toolbox"
)

# ── Profile definitions ──────────────────────────────────────────────────────
typeset -A PROFILE_CATS=(
  [work]="alt_tools docker kubernetes dev_apps macos_utils macos_media"
  [personal]="alt_tools macos_utils macos_cosmetic macos_media productivity peripherals"
  [minimal]="alt_tools"
  [full]="alt_tools docker kubernetes macos_utils macos_cosmetic macos_media dev_apps touchbar gaming productivity peripherals"
)

typeset -A PROFILE_EXCL=(
  [work]="macos_media/spotify macos_media/iina macos_utils/nordvpn macos_utils/utm macos_utils/transmission macos_utils/netspot"
  [personal]="macos_utils/displaylink macos_utils/utm macos_utils/duckdb"
  [minimal]=""
  [full]=""
)

# ── Banner ───────────────────────────────────────────────────────────────────
echo ""
echo "${bold}${cyan}┌─ dots-setup ──────────────────────────────────────────────┐${reset}"
echo "${bold}${cyan}│  Machine profile wizard                                    │${reset}"
echo "${bold}${cyan}└───────────────────────────────────────────────────────────┘${reset}"
echo ""

# ── Step 1: Profile ──────────────────────────────────────────────────────────
profile=$(printf '%s\n' work personal minimal full | \
  fzf --no-multi --no-sort \
    --prompt "Profile › " \
    --header "Select a starting profile — you'll customise packages in the next step" \
    --preview 'case {} in
      work)     echo "alt_tools · docker · kubernetes · dev_apps · macos_utils · macos_media\n\nDefault excludes: spotify, iina, nordvpn, utm, transmission, netspot" ;;
      personal) echo "alt_tools · macos_utils · macos_cosmetic · macos_media · productivity · peripherals\n\nDefault excludes: displaylink, utm, duckdb" ;;
      minimal)  echo "alt_tools only" ;;
      full)     echo "Everything — all categories, no excludes" ;;
    esac' \
    --preview-window 'right:40%:wrap')

echo ""
echo "${bold}Profile: ${green}${profile}${reset}"
echo ""

# ── Step 2: Build items + preselection ──────────────────────────────────────
all_items=()
preselected=()

for cat in "${CAT_ORDER[@]}"; do
  for pkg in ${=CAT_PKGS[$cat]}; do
    item="${cat}/${pkg}"
    all_items+=("$item")

    cat_enabled=false
    [[ " ${PROFILE_CATS[$profile]} " == *" $cat "* ]] && cat_enabled=true

    if $cat_enabled; then
      excl="${PROFILE_EXCL[$profile]:-}"
      if [[ -z "$excl" || " $excl " != *" ${item} "* ]]; then
        preselected+=("$item")
      fi
    fi
  done
done

# ── Step 2: State-file + reload package picker ───────────────────────────────
# fzf's change-query is async so change-query+select-all can't reliably filter
# a group. Instead we manage selection state in a file and use execute-silent
# + reload, which is synchronous and works for both individual and group toggles.

_state_file=$(mktemp /tmp/dots-setup-state.XXXXXX)
_order_file=$(mktemp /tmp/dots-setup-order.XXXXXX)
_cats_file=$(mktemp /tmp/dots-setup-cats.XXXXXX)
_display_script=$(mktemp /tmp/dots-setup-display.XXXXXX)
_toggle_script=$(mktemp /tmp/dots-setup-toggle.XXXXXX)
_pos_file=$(mktemp /tmp/dots-setup-pos.XXXXXX)
_desc_file=$(mktemp /tmp/dots-setup-desc.XXXXXX)
_preview_script=$(mktemp /tmp/dots-setup-preview.XXXXXX)
trap 'rm -f "$_state_file" "$_order_file" "$_cats_file" "$_display_script" "$_toggle_script" "$_pos_file" "$_desc_file" "$_preview_script"' EXIT

# Seed state with preselected items
printf '%s\n' "${preselected[@]}" > "$_state_file"

# Order file: H: headers, I: items
prev_cat=""
for item in "${all_items[@]}"; do
  cat="${item%%/*}"
  if [[ "$cat" != "$prev_cat" ]]; then
    printf 'H:── %s  [%s]\n' "${CAT_DESC[$cat]}" "$cat" >> "$_order_file"
    prev_cat="$cat"
  fi
  printf 'I:%s\n' "$item" >> "$_order_file"
done

# Cats file: cat:pkg1 pkg2 ...
for cat in "${CAT_ORDER[@]}"; do
  printf '%s:%s\n' "$cat" "${CAT_PKGS[$cat]}" >> "$_cats_file"
done

# Display script: reads order+state, prints [✓]/[ ] prefixed lines
chmod +x "$_display_script"
cat > "$_display_script" << DISPLAY
#!/bin/zsh
while IFS= read -r line; do
  type="\${line:0:2}" entry="\${line:2}"
  if [[ "\$type" == "H:" ]]; then
    printf '    %s\n' "\$entry"
  elif grep -qF "\$entry" "$_state_file" 2>/dev/null; then
    printf '[✓] %s\n' "\$entry"
  else
    printf '[ ] %s\n' "\$entry"
  fi
done < "$_order_file"
DISPLAY

# Toggle script: updates state file for item or whole category group
chmod +x "$_toggle_script"
cat > "$_toggle_script" << TOGGLE
#!/bin/zsh
raw="\$1"
# Strip display prefix
item="\$(printf '%s' "\$raw" | sed 's/^\[.\] //' | sed 's/^    //')"
if [[ "\$item" != */* ]] && [[ "\$item" =~ '\[([a-z_]+)\]$' ]]; then
  cat_name="\${match[1]}"
  pkgs=\$(grep "^\${cat_name}:" "$_cats_file" | cut -d: -f2-)
  any=0
  for pkg in \${=pkgs}; do
    grep -qF "\${cat_name}/\${pkg}" "$_state_file" && any=1 && break
  done
  for pkg in \${=pkgs}; do
    if [[ \$any -eq 1 ]]; then
      grep -vF "\${cat_name}/\${pkg}" "$_state_file" > "$_state_file.tmp"
    else
      grep -vF "\${cat_name}/\${pkg}" "$_state_file" > "$_state_file.tmp"
      echo "\${cat_name}/\${pkg}" >> "$_state_file.tmp"
    fi
    mv "$_state_file.tmp" "$_state_file"
  done
else
  if grep -qF "\$item" "$_state_file"; then
    grep -vF "\$item" "$_state_file" > "$_state_file.tmp" && mv "$_state_file.tmp" "$_state_file"
  else
    echo "\$item" >> "$_state_file"
  fi
fi
TOGGLE

# ── Descriptions ─────────────────────────────────────────────────────────────
# Fetch brew descriptions for all packages in one call, then add cat descriptions.
# Format for both: "key: description"
{
  all_pkgs=()
  for cat in "${CAT_ORDER[@]}"; do
    for pkg in ${=CAT_PKGS[$cat]}; do
      all_pkgs+=("$pkg")
    done
  done
  brew desc "${all_pkgs[@]}" 2>/dev/null || true
  for cat in "${CAT_ORDER[@]}"; do
    printf '%s: %s\n' "$cat" "${CAT_DESC[$cat]}"
  done
} > "$_desc_file"

chmod +x "$_preview_script"
cat > "$_preview_script" << PREVIEW
#!/bin/zsh
raw="\$1"
item="\$(printf '%s' "\$raw" | sed 's/^\[.\] //' | sed 's/^    //')"

if [[ "\$item" == */* ]]; then
  key="\${item#*/}"
else
  [[ "\$item" =~ '\[([a-z_]+)\]' ]] && key="\${match[1]}" || exit 0
fi

desc=\$(grep "^\${key}: " "${_desc_file}" 2>/dev/null | sed 's/^[^:]*: //')
printf '%s\n%s\n%s\n' "\$key" "────────────────────────────────────" "\${desc:-No description available.}"
PREVIEW

# ── fzf picker ────────────────────────────────────────────────────────────────
echo "${bold}Customise packages${reset}  ${dim}Space/Tab: toggle · Enter: confirm${reset}"
echo ""

"$_display_script" | fzf --no-sort --ansi \
  --preview "$_preview_script {}" \
  --preview-window 'right:40%:wrap' \
  --bind "space:execute-silent(echo \$FZF_POS > $_pos_file; $_toggle_script {})+reload-sync($_display_script)+transform(echo \"pos(\$(cat $_pos_file))\")" \
  --bind "tab:execute-silent(echo \$FZF_POS > $_pos_file; $_toggle_script {})+reload-sync($_display_script)+transform(echo \"pos(\$(cat $_pos_file))\")" \
  --bind "shift-tab:execute-silent(echo \$FZF_POS > $_pos_file; $_toggle_script {})+reload-sync($_display_script)+transform(echo \"pos(\$(cat $_pos_file))\")" \
  --pointer '▶ ' \
  --color 'pointer:6,header:3' \
  --header "Profile: $profile  |  Space/Tab: toggle  |  Enter: confirm" \
  --prompt "Packages › " > /dev/null

selected=("${(@f)$(grep -v '^$' "$_state_file")}")

if [[ ${#selected[@]} -eq 0 ]]; then
  echo "No packages selected. Aborting." >&2
  exit 1
fi

# ── Parse selection → category flags + machine_excludes ─────────────────────
typeset -A enabled_cats
machine_excludes=()

for item in "${selected[@]}"; do
  cat="${item%%/*}"
  enabled_cats[$cat]=1
done

for cat in "${CAT_ORDER[@]}"; do
  if [[ -n "${enabled_cats[$cat]:-}" ]]; then
    for pkg in ${=CAT_PKGS[$cat]}; do
      item="${cat}/${pkg}"
      found=false
      for s in "${selected[@]}"; do
        [[ "$s" == "$item" ]] && found=true && break
      done
      $found || machine_excludes+=("$pkg")
    done
  fi
done

# ── Step 3: Editor ───────────────────────────────────────────────────────────
echo ""
editor=$(printf '%s\n' fresh nvim vim code | \
  fzf --no-multi --no-sort \
    --prompt "Editor › " \
    --header "Preferred editor")

# ── Step 4: Touch ID for sudo ────────────────────────────────────────────────
touch_id_sudo=$(printf '%s\n' true false | \
  fzf --no-multi --no-sort \
    --prompt "Touch ID for sudo › " \
    --header "Enable Touch ID for sudo? (macOS 14+)")

# ── Step 5: Dark-mode location (Hammerspoon darkmode.lua) ────────────────────
# Sun times for the auto light/dark switch are computed locally from lat/long.
# Only prompted when macos_utils (Hammerspoon) is enabled; otherwise defaults
# (or the values already in chezmoi.toml) are kept.
_dm_get() { grep -E "^  $1 " "$CHEZMOI_CONFIG" 2>/dev/null | sed -E 's/^[^=]*= *//; s/^"//; s/"$//'; }
darkmode_city=$(_dm_get darkmode_city);                   : "${darkmode_city:=Tallinn, Estonia}"
darkmode_lat=$(_dm_get darkmode_latitude);                : "${darkmode_lat:=59.4370}"
darkmode_lon=$(_dm_get darkmode_longitude);               : "${darkmode_lon:=24.7536}"
darkmode_sunset=$(_dm_get darkmode_sunset_offset_min);    : "${darkmode_sunset:=-30}"
darkmode_sunrise=$(_dm_get darkmode_sunrise_offset_min);  : "${darkmode_sunrise:=0}"

_caps="$HOME/.local/share/dots-setup/capitals.tsv"
# Fall back to the source tree if chezmoi hasn't deployed the file yet (first run).
[[ -f "$_caps" ]] || _caps="$(chezmoi source-path)/dot_local/share/dots-setup/capitals.tsv"
if [[ -n "${enabled_cats[macos_utils]:-}" && -f "$_caps" ]]; then
  echo ""
  _pick=$( { printf 'Custom (enter coordinates manually)\t\t\n'; cat "$_caps"; } | \
    fzf --no-multi --delimiter='\t' --with-nth=1 \
      --prompt "Dark-mode location › " \
      --header "City used for sunrise/sunset (auto light/dark)" \
      --query "${darkmode_city%%,*}" )
  if [[ -n "$_pick" ]]; then
    _city=${_pick%%$'\t'*}
    if [[ "$_city" == Custom* ]]; then
      printf "${bold}Latitude${reset} (e.g. 59.4370): ";  read -r darkmode_lat
      printf "${bold}Longitude${reset} (e.g. 24.7536): "; read -r darkmode_lon
      printf "${bold}City label${reset}: ";               read -r darkmode_city
    else
      darkmode_city="$_city"
      darkmode_lat=$(printf '%s' "$_pick" | cut -f2)
      darkmode_lon=$(printf '%s' "$_pick" | cut -f3)
    fi
  fi
  echo ""
  echo "${dim}Switch offsets: minutes relative to the event — negative = before, positive = after.${reset}"
  printf "${bold}Sunset offset (go dark)${reset} [${darkmode_sunset}]: "
  read -r _s; darkmode_sunset=${_s:-$darkmode_sunset}
  printf "${bold}Sunrise offset (go light)${reset} [${darkmode_sunrise}]: "
  read -r _r; darkmode_sunrise=${_r:-$darkmode_sunrise}
fi

# ── Write chezmoi.toml ───────────────────────────────────────────────────────
mkdir -p "$(dirname "$CHEZMOI_CONFIG")"

# Preserve sourceDir if already set (manual per-machine override)
_source_dir_line=""
if [[ -f "$CHEZMOI_CONFIG" ]]; then
  _source_dir_line=$(grep '^sourceDir' "$CHEZMOI_CONFIG" || true)
fi

# Build TOML array for machine_excludes
excl_toml="["
for e in "${machine_excludes[@]}"; do
  excl_toml+="\"${e}\", "
done
excl_toml="${excl_toml%", "}]"

_flag() { [[ -n "${enabled_cats[$1]:-}" ]] && echo true || echo false; }

cat > "$CHEZMOI_CONFIG" <<TOML
[data]
  profile        = "$profile"
  editor         = "$editor"
  touch_id_sudo  = $touch_id_sudo

  alt_tools      = $(_flag alt_tools)
  docker         = $(_flag docker)
  kubernetes     = $(_flag kubernetes)
  macos_utils    = $(_flag macos_utils)
  macos_cosmetic = $(_flag macos_cosmetic)
  macos_media    = $(_flag macos_media)
  dev_apps       = $(_flag dev_apps)
  touchbar       = $(_flag touchbar)
  gaming         = $(_flag gaming)
  productivity   = $(_flag productivity)
  peripherals    = $(_flag peripherals)
  onepassword    = $(_flag onepassword)

  machine_excludes = $excl_toml

  darkmode_city               = "$darkmode_city"
  darkmode_latitude           = $darkmode_lat
  darkmode_longitude          = $darkmode_lon
  darkmode_sunset_offset_min  = $darkmode_sunset
  darkmode_sunrise_offset_min = $darkmode_sunrise
TOML

# Re-inject sourceDir if it was present before (manual per-machine override)
if [[ -n "$_source_dir_line" ]]; then
  printf '%s\n' "$_source_dir_line" | cat - "$CHEZMOI_CONFIG" > "$CHEZMOI_CONFIG.tmp" && mv "$CHEZMOI_CONFIG.tmp" "$CHEZMOI_CONFIG"
fi

echo ""
echo "${bold}${green}✓ Config written → $CHEZMOI_CONFIG${reset}"
echo ""
echo "${bold}Applying dotfiles...${reset}"
chezmoi apply
echo ""
echo "${bold}${green}✓ Done.${reset}  Run ${bold}dots-setup${reset} any time to reconfigure."
echo ""

#!/usr/bin/env bash
# apt update + upgrade on all OCI hosts (gha-* in ~/.ssh/config) in parallel.
# Never reboots. Skips hosts with a running Actions job unless --force.
usage() {
  echo "Usage: oci-upgrade [--dry-run] [--force] [--no-apt] [--reboot] [--wait] [-c CMD]... [--timeout SECS] [host-filter-regex]" >&2
}
dry=0 force=0 noapt=0 reboot=0 wait=0 tmo=1800 filter="" extra=""
while [ $# -gt 0 ]; do
  case "$1" in
    -n | --dry-run) dry=1 ;;
    -f | --force) force=1 ;;
    --no-apt) noapt=1 ;;
    --reboot) reboot=1 ;;
    -w | --wait) wait=1 ;;
    -c | --cmd) extra="$extra
( ${2:?} ) </dev/null || exit 1"; shift ;;
    -t | --timeout) tmo="${2:?}"; shift ;;
    -h | --help) usage; exit 0 ;;
    -*) usage; exit 2 ;;
    *) filter="$1" ;;
  esac
  shift
done

hosts=$(awk '$1=="Host" && $2 ~ /^gha-/ {print $2}' ~/.ssh/config)
[ -n "$filter" ] && hosts=$(printf '%s\n' "$hosts" | command grep -E -- "$filter")
[ -z "$hosts" ] && { echo "no matching hosts" >&2; exit 2; }

remote='
export DEBIAN_FRONTEND=noninteractive
sudo -n true 2>/dev/null || { echo "ERROR: passwordless sudo missing"; exit 90; }
busy() { pgrep -f Runner.Worker >/dev/null; }
wait_idle() {
  n=0
  while busy; do
    [ "$WAIT" = 1 ] || return 1
    [ $((n % 20)) = 0 ] && echo "waiting for running job to finish"
    n=$((n + 1)); sleep 30
  done
}
if [ "$FORCE" != 1 ] && ! wait_idle; then
  echo "SKIPPED: Actions job running (use --force or --wait)"; exit 91
fi
if [ "$NOAPT" != 1 ]; then
sudo -n apt-get -o DPkg::Lock::Timeout=600 update -y || exit 1
sudo -n apt-get -o DPkg::Lock::Timeout=600 upgrade -y -o Dpkg::Options::=--force-confold || exit 1
fi
EXTRA
if [ -f /var/run/reboot-required ]; then echo "REBOOT REQUIRED"
  if [ "$REBOOT" = 1 ]; then
    if ! wait_idle; then echo "reboot skipped: Actions job running"
    else echo "REBOOTING"; nohup sh -c "sleep 3; sudo -n systemctl reboot" >/dev/null 2>&1 </dev/null & fi
  fi
fi
'

remote=${remote/EXTRA/$extra}

if [ "$dry" = 1 ]; then
  echo "hosts:"; printf '  %s\n' $hosts
  echo "per host (timeout ${tmo}s, force=$force): ssh -o BatchMode=yes -o ConnectTimeout=10 <host> bash -s <<<"
  echo "$remote"
  exit 0
fi

d=$(mktemp -d); trap 'rm -rf "$d"' EXIT
for h in $hosts; do
  (
    printf '%s' "$remote" | perl -e 'alarm shift; exec @ARGV' "$tmo" \
      ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3 \
      "$h" "FORCE=$force NOAPT=$noapt REBOOT=$reboot WAIT=$wait bash -s" 2>&1 | tee "$d/$h.out" | awk -v h="$h" '{print "[" h "] " $0; fflush()}'
    echo "${PIPESTATUS[1]}" >"$d/$h.rc"
  ) &
done
wait

fail=0
echo; echo "===== summary ====="
for h in $hosts; do
  rc=$(cat "$d/$h.rc")
  case $rc in
    0) s="ok" ;;
    90) s="FAIL (no passwordless sudo)" ;;
    91) s="SKIPPED (job running)"; fail=1 ;;
    142) s="FAIL (timeout ${tmo}s)" ;;
    255) s="FAIL (ssh error)" ;;
    *) s="FAIL (rc=$rc)" ;;
  esac
  [ "$rc" != 0 ] && fail=1
  if command grep -q '^REBOOTING' "$d/$h.out"; then s="$s  [rebooting]"
  elif command grep -q '^REBOOT REQUIRED' "$d/$h.out"; then s="$s  [reboot required]"; fi
  printf '%-12s %s\n' "$h" "$s"
done
exit $fail

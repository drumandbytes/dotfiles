#!/bin/bash
# Runs whenever ~/.Brewfile or profile data changes (chezmoi run_onchange_).
# Installs/updates all Homebrew packages declared in the Brewfile.
# Brewfile template hash: {{ include "dot_Brewfile.tmpl" | sha256sum }}
# Profile data: {{ list .kubernetes .docker .dev_apps .gaming .productivity .alt_tools .macos_utils .macos_cosmetic .macos_media .touchbar .peripherals .onepassword | join "," }} excludes={{ join "," .machine_excludes }}

set -euo pipefail

# Homebrew + mise (binary and shims) on PATH: `brew bundle` runs outside an
# interactive shell, and the Brewfile's `npm` entry is handled by mise's npm
# shim, which calls `mise reshim` after a global install.
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$HOME/.local/share/mise/shims:$PATH"

if ! command -v brew &>/dev/null; then
    echo "Homebrew not found — skipping brew bundle."
    exit 0
fi

echo "Running brew bundle..."
brew bundle --global
echo "✅ brew bundle complete."

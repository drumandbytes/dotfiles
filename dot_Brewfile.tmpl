# =============================================================================
# Taps
# =============================================================================
{{ if .kubernetes -}}
tap "hashicorp/tap"
{{ end -}}
{{ if .macos_cosmetic -}}
tap "lihaoyun6/tap"
tap "theboredteam/boring-notch"
{{ end -}}
{{ if .dev_apps -}}
tap "hamed-elfayome/claude-usage"
{{ end -}}
{{ if .productivity -}}
tap "xykong/tap"
{{ end -}}

# =============================================================================
# Base — always installed
# =============================================================================

# Shell infrastructure
brew "atuin"
brew "carapace"
brew "direnv"
brew "fzf"
brew "mise"
brew "sheldon"
brew "starship"
brew "zoxide"

# Git
brew "git-delta"
brew "gnupg"
brew "lazygit"
brew "pinentry-mac"

# Core CLI
brew "btop"
brew "jq"
brew "yq"
brew "just"
brew "mac-cleanup-go"
brew "rust"
brew "shfmt"
brew "wget2"

# Terminal & Font
cask "kitty"
cask "font-meslo-lg-nerd-font"

# Editor
{{ if eq .editor "fresh" -}}
brew "fresh-editor"
{{ end -}}

brew "chezmoi"
brew "exiftool"
brew "imagemagick"
brew "jpegoptim"
brew "parallel"
brew "pv"
cask "mac-mouse-fix"

# =============================================================================
# Alt-tools — modern CLI replacements
# =============================================================================
{{ if .alt_tools -}}
brew "bat"
brew "duf"
brew "dust"
brew "eza"
brew "fd"
brew "ripgrep"
brew "tldr"
{{ if not (has .machine_excludes "doggo") -}}
brew "doggo"
{{ end -}}
{{ if not (has .machine_excludes "gping") -}}
brew "gping"
{{ end -}}
{{ if not (has .machine_excludes "gron") -}}
brew "gron"
{{ end -}}
{{ if not (has .machine_excludes "jid") -}}
brew "jid"
{{ end -}}
{{ if not (has .machine_excludes "navi") -}}
brew "navi"
{{ end -}}
{{ if not (has .machine_excludes "xh") -}}
brew "xh"
{{ end -}}
# pkg:end:alt_tools
{{ end -}}

# =============================================================================
# Bitwarden
# =============================================================================
{{ if .bitwarden -}}
brew "bitwarden-cli"
cask "bitwarden"
# pkg:end:bitwarden
{{ end -}}

# =============================================================================
# Docker + Colima
# =============================================================================
{{ if .docker -}}
brew "colima", restart_service: :changed
brew "docker"
brew "docker-buildx"
brew "docker-compose"
{{ if not (has .machine_excludes "lima-additional-guestagents") -}}
brew "lima-additional-guestagents"
{{ end -}}
# pkg:end:docker
{{ end -}}

# =============================================================================
# Kubernetes
# =============================================================================
{{ if .kubernetes -}}
brew "helm"
brew "kubecolor"
brew "kubernetes-cli"
brew "kubectx"
brew "k9s"
{{ if not (has .machine_excludes "kubeconform") -}}
brew "kubeconform"
{{ end -}}
{{ if not (has .machine_excludes "mintoolkit") -}}
brew "mintoolkit"
{{ end -}}
{{ if not (has .machine_excludes "stern") -}}
brew "stern"
{{ end -}}
{{ if not (has .machine_excludes "vault") -}}
brew "hashicorp/tap/vault"
{{ end -}}
{{ if not (has .machine_excludes "gcloud-cli") -}}
cask "gcloud-cli"
{{ end -}}
{{ if not (has .machine_excludes "kustomize") -}}
brew "kustomize"
{{ end -}}
# pkg:end:kubernetes
{{ end -}}

# =============================================================================
# macOS utilities
# =============================================================================
{{ if .macos_utils -}}
cask "alt-tab"
cask "hammerspoon"
cask "hot"
cask "mos@beta"
cask "raycast"
{{ if not (has .machine_excludes "displaylink") -}}

# =============================================================================
# Taps
# =============================================================================
{{ if .kubernetes -}}
tap "hashicorp/tap"
{{ end -}}
{{ if .macos_cosmetic -}}
tap "lihaoyun6/tap"
tap "theboredteam/boring-notch"
{{ end -}}
{{ if .dev_apps -}}
tap "hamed-elfayome/claude-usage"
{{ end -}}
{{ if .productivity -}}
tap "xykong/tap"
{{ end -}}

# =============================================================================
# Base — always installed
# =============================================================================

# Shell infrastructure
brew "atuin"
brew "carapace"
brew "direnv"
brew "fzf"
brew "mise"
brew "sheldon"
brew "starship"
brew "zoxide"

# Git
brew "git-delta"
brew "gnupg"
brew "lazygit"
brew "pinentry-mac"

# Core CLI
brew "btop"
brew "jq"
brew "yq"
brew "just"
brew "mac-cleanup-go"
brew "rust"
brew "shfmt"
brew "wget2"

# Terminal & Font
cask "kitty"
cask "font-meslo-lg-nerd-font"

# Editor
{{ if eq .editor "fresh" -}}
brew "fresh-editor"
{{ end -}}

brew "chezmoi"
brew "exiftool"
brew "imagemagick"
brew "jpegoptim"
brew "parallel"
brew "pv"
cask "mac-mouse-fix"

# =============================================================================
# Alt-tools — modern CLI replacements
# =============================================================================
{{ if .alt_tools -}}
brew "bat"
brew "duf"
brew "dust"
brew "eza"
brew "fd"
brew "ripgrep"
brew "tldr"
{{ if not (has "doggo" .machine_excludes) -}}
brew "doggo"
{{ end -}}
{{ if not (has "gping" .machine_excludes) -}}
brew "gping"
{{ end -}}
{{ if not (has "gron" .machine_excludes) -}}
brew "gron"
{{ end -}}
{{ if not (has "jid" .machine_excludes) -}}
brew "jid"
{{ end -}}
{{ if not (has "navi" .machine_excludes) -}}
brew "navi"
{{ end -}}
{{ if not (has "xh" .machine_excludes) -}}
brew "xh"
{{ end -}}
# pkg:end:alt_tools
{{ end -}}

# =============================================================================
# Bitwarden
# =============================================================================
{{ if .bitwarden -}}
brew "bitwarden-cli"
cask "bitwarden"
# pkg:end:bitwarden
{{ end -}}

# =============================================================================
# Docker + Colima
# =============================================================================
{{ if .docker -}}
brew "colima", restart_service: :changed
brew "docker"
brew "docker-buildx"
brew "docker-compose"
{{ if not (has "lima-additional-guestagents" .machine_excludes) -}}
brew "lima-additional-guestagents"
{{ end -}}
# pkg:end:docker
{{ end -}}

# =============================================================================
# Kubernetes
# =============================================================================
{{ if .kubernetes -}}
brew "helm"
brew "kubecolor"
brew "kubernetes-cli"
brew "kubectx"
brew "k9s"
{{ if not (has "kubeconform" .machine_excludes) -}}
brew "kubeconform"
{{ end -}}
{{ if not (has "mintoolkit" .machine_excludes) -}}
brew "mintoolkit"
{{ end -}}
{{ if not (has "stern" .machine_excludes) -}}
brew "stern"
{{ end -}}
{{ if not (has "vault" .machine_excludes) -}}
brew "hashicorp/tap/vault"
{{ end -}}
{{ if not (has "gcloud-cli" .machine_excludes) -}}
cask "gcloud-cli"
{{ end -}}
{{ if not (has "kustomize" .machine_excludes) -}}
brew "kustomize"
{{ end -}}
# pkg:end:kubernetes
{{ end -}}

# =============================================================================

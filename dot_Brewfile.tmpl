{{ end -}}
{{ if not (has .machine_excludes "linearmouse") -}}
cask "linearmouse"
{{ end -}}
{{ if not (has .machine_excludes "netspot") -}}
cask "netspot"
{{ end -}}
{{ if not (has .machine_excludes "sniffnet") -}}
brew "sniffnet"
{{ end -}}
{{ if not (has .machine_excludes "keyboardcleantool") -}}
cask "keyboardcleantool"
{{ end -}}
{{ if not (has .machine_excludes "nordvpn") -}}
cask "nordvpn"
{{ end -}}
{{ if not (has .machine_excludes "transmission") -}}
cask "transmission"
{{ end -}}
{{ if not (has .machine_excludes "utm") -}}
cask "utm"
{{ end -}}
{{ if not (has .machine_excludes "duckdb") -}}
brew "duckdb"
{{ end -}}
{{ if not (has .machine_excludes "rbenv") -}}
brew "rbenv"
